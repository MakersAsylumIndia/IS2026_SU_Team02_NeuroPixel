const int emgPin1 = 32;
const int emgPin2 = 33;
const int emgPin3 = 34;
const int emgPin4 = 35;

void setup() {
  Serial.begin(115200);
  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);

  // Print column headers
  Serial.println("CH1 (GPIO32)  |  CH2 (GPIO33)  |  CH3 (GPIO34)  |  CH4 (GPIO35)");
  Serial.println("--------------------------------------------------------------");
}

void loop() {
  int ch1 = analogRead(emgPin1);
  int ch2 = analogRead(emgPin2);
  int ch3 = analogRead(emgPin3);
  int ch4 = analogRead(emgPin4);

  // Print all 4 in columns with padding
  Serial.printf("%-14d| %-15d| %-15d| %d\n", ch1, ch2, ch3, ch4);

  delay(500);
}

